{
	"semi": false,
	"singleQuote": true,
	"trailingComma": "all",
	"printWidth": 100,
	"useTabs": true,
	"tabWidth": 4,
	"plugins": ["@ianvs/prettier-plugin-sort-imports"],
	"importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "", "^[.]"],
	"importOrderTypeScriptVersion": "5.0.0",
	"overrides": [
		{
			"files": ["*.md", "*.yml", "*.yaml"],
			"options": { "useTabs": false, "tabWidth": 2 }
		}
	]
}
